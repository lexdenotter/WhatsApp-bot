      "name": "Foutmelding opstellen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        900
      ],
      "parameters": {
        "jsCode": "const inst = $('Instellingen aanbiedingen').first().json;\nconst chatId = String(inst.chatId || '').trim();\nif (!chatId) { return []; }\nconst meldingen = $input.all().map(i => {\n  const e = i.json.error;\n  if (e && typeof e === 'object') { return e.message || JSON.stringify(e); }\n  return String(e || i.json.message || 'onbekende fout');\n});\nreturn [{ json: { chatId, tekst: `⚠️ Het ophalen van de aanbiedingen is (deels) mislukt:\\n${[...new Set(meldingen)].map(m => '• ' + m).join('\\n')}\\n\\nZie de uitvoeringsdetails in n8n.` } }];"
      }
    },
