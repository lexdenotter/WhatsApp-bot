    {
      "id": "8207edf6-4358-40bd-8f7e-1a541cc30fff",
      "name": "AH HTML naar tekst",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -900,
        -160
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "jsCode": "// ah.nl rendert de bonuspagina client-side; daarom gebruiken we een server-gerenderde\n// aggregatorpagina en laten we Gemini de aanbiedingen uit de kale tekst halen.\nlet html = String($input.first().json.data || '');\nhtml = html.replace(/<script[\\s\\S]*?<\\/script>/gi, ' ').replace(/<style[\\s\\S]*?<\\/style>/gi, ' ');\nlet tekst = html\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/&nbsp;/gi, ' ')\n  .replace(/&amp;/gi, '&')\n  .replace(/&euro;/gi, '€')\n  .replace(/\\s+/g, ' ')\n  .trim();\nif (tekst.length < 500) {\n  throw new Error('De AH-aanbiedingenpagina leverde te weinig tekst op — structuur gewijzigd of verzoek geblokkeerd.');\n}\nreturn [{ json: { tekst: tekst.slice(0, 60000) } }];"
      }
    },
    {
      "id": "7ff4a276-b7d4-4b68-aca8-92fcca8cd576",
      "name": "AH aanbiedingen extraheren",
      "type": "@n8n/n8n-nodes-langchain.informationExtractor",
      "typeVersion": 1.2,
      "position": [
        -680,
        -160
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "text": "={{ $json.tekst }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"aanbiedingen\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"product\": { \"type\": \"string\", \"description\": \"Naam van het product of de productgroep\" },\n          \"prijs\": { \"type\": \"string\", \"description\": \"Actieprijs in euro's, bijv. 2.49 (leeg indien onbekend)\" },\n          \"korting\": { \"type\": \"string\", \"description\": \"Het kortingsmechanisme, bijv. '1+1 gratis' of '25% korting'\" },\n          \"geldig_tot\": { \"type\": \"string\", \"description\": \"Einddatum jjjj-mm-dd indien vermeld, anders leeg\" }\n        },\n        \"required\": [\"product\"]\n      }\n    }\n  },\n  \"required\": [\"aanbiedingen\"]\n}",
        "options": {
          "systemPromptTemplate": "Je krijgt de kale tekst van een Nederlandse pagina met supermarktaanbiedingen van Albert Heijn. Haal er alle concrete productaanbiedingen uit. Sla navigatie, cookiemeldingen en andere ruis over. Geef alleen echte aanbiedingen terug."
        }
      }
    },
    {
      "id": "ac38e02e-843a-4e2e-b350-3c082c21e415",
      "name": "AH normaliseren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        -160
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "jsCode": "const uit = $input.first().json.output || $input.first().json;\nconst lijst = (uit.aanbiedingen || []).filter(a => a && a.product);\nif (!lijst.length) {\n  throw new Error('Geen AH-aanbiedingen kunnen extraheren uit de pagina.');\n}\nconst vandaag = new Date().toISOString().slice(0, 10);\nconst offers = lijst.map(a => ({\n  winkel: 'AH',\n  product: String(a.product).trim(),\n  prijs: String(a.prijs || '').trim(),\n  korting: String(a.korting || '').trim(),\n  geldig_tot: String(a.geldig_tot || '').trim(),\n  opgehaald_op: vandaag,\n}));\nreturn [{ json: { winkel: 'AH', aantal: offers.length, aanbiedingen: offers } }];"
      }
    },
