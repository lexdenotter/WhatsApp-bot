    {
      "id": "e1000000-0000-4000-8000-000000000012",
      "name": "Match & weekbericht",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        160
      ],
      "parameters": {
        "jsCode": "const inst = $('Instellingen aanbiedingen').first().json;\nconst chatId = String(inst.chatId || '').trim();\nif (!chatId) { return []; } // geen chat-id ingesteld → stil eindigen\n\nfunction veilig(naam) {\n  try { return $(naam).first().json; } catch (e) { return null; }\n}\nconst ah = veilig('AH normaliseren');\nconst plus = veilig('Plus normaliseren');\nconst offers = [\n  ...((ah && ah.aanbiedingen) || []),\n  ...((plus && plus.aanbiedingen) || []),\n];\n\n// 'Vaak gekocht' = items die 2+ keer op een lijst hebben gestaan\nconst historie = $input.all().map(i => i.json).filter(r => r && r.tekst);\nconst freq = {};\nfor (const r of historie) {\n  const t = String(r.tekst).toLowerCase().trim();\n  if (t.length > 2) { freq[t] = (freq[t] || 0) + 1; }\n}\nconst vaak = Object.entries(freq).filter(([, n]) => n >= 2).map(([t]) => t);\n\nconst matches = [];\nfor (const o of offers) {\n  const p = String(o.product).toLowerCase();\n  for (const v of vaak) {\n    if (p.includes(v) || v.includes(p)) {\n      matches.push(`• [${o.winkel}] ${o.product}${o.korting ? ' — ' + o.korting : ''}`);\n      break;\n    }\n  }\n}\n\nconst delen = [];\ndelen.push(`🛒 Aanbiedingen opgehaald: ${ah ? ah.aantal + ' van AH' : 'AH mislukt'}, ${plus ? plus.aantal + ' van Plus' : 'Plus mislukt'}.`);\nif (matches.length) {\n  delen.push(`\\nDeze week in de aanbieding van jullie vaste boodschappen:\\n${[...new Set(matches)].join('\\n')}`);\n} else {\n  delen.push('\\nGeen van jullie vaste boodschappen is deze week in de aanbieding (of er is nog te weinig boodschappenhistorie).');\n}\ndelen.push('\\nVraag me gerust: \"is er ... in de aanbieding?\" of \"wat eten we deze week?\"');\nreturn [{ json: { chatId, tekst: delen.join('\\n') } }];"
      }
    },
