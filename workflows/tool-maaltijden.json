      "parameters": {
        "jsCode": "// Controleer eerst of de schrijfactie hierboven wel gelukt is: die node gaat bij een\n// fout gewoon door, dus zonder deze check zou hier succes gemeld worden terwijl er niets\n// is opgeslagen.\nconst schrijfUitvoer = $input.all().map(i => i.json);\nif (schrijfUitvoer.length > 0 && schrijfUitvoer[0] && schrijfUitvoer[0].error != null) {\n  return [{ json: { resultaat: 'Het verwijderen van de maaltijd is niet gelukt.' } }];\n}\nconst gevonden = $('Zoek maaltijd').all().map(i => i.json);\nif (gevonden.length && gevonden[0].geenMatch) {\n  return [{ json: { resultaat: gevonden[0].melding } }];\n}\nconst regels = gevonden.map(g => `${g.gerecht} (${g.gegeten_op})`);\nreturn [{ json: { resultaat: `Verwijderd: ${regels.join(', ')}` } }];\n"
      }
