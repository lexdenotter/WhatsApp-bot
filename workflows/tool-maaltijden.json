      "parameters": {
        "jsCode": "// Controleer eerst of de schrijfactie hierboven wel gelukt is: die node gaat bij een\n// fout gewoon door, dus zonder deze check zou hier succes gemeld worden terwijl er niets\n// is opgeslagen.\nconst schrijfUitvoer = $input.all().map(i => i.json);\nif (schrijfUitvoer.length > 0 && schrijfUitvoer[0] && schrijfUitvoer[0].error != null) {\n  return [{ json: { resultaat: 'Het opslaan van de voorkeur is niet gelukt. Controleer in n8n of de tabel \\'voorkeuren\\' is geselecteerd in de node \\'Voorkeur opslaan\\'.' } }];\n}\nconst invoer = $('Normaliseren').first().json;\nif (!invoer.sleutel || !invoer.waarde) {\n  return [{ json: { resultaat: 'Om een voorkeur op te slaan zijn zowel een sleutel als een waarde nodig.' } }];\n}\nreturn [{ json: { resultaat: `Voorkeur opgeslagen: ${invoer.sleutel} = ${invoer.waarde}` } }];"
      }
