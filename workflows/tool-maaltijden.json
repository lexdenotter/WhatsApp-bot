    {
      "id": "c1000000-0000-4000-8000-000000000013",
      "name": "Zoek maaltijd",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        300
      ],
      "parameters": {
        "jsCode": "const invoer = $('Normaliseren').first().json;\nconst rijen = $input.all().map(i => i.json).filter(r => r && r.gerecht);\nconst gezocht = String(invoer.gerecht || '').toLowerCase().trim();\nif (!gezocht) {\n  return [{ json: { id: '', geenMatch: true, melding: 'Geef aan welke maaltijd verwijderd moet worden.' } }];\n}\nlet matches = rijen.filter(r => {\n  const g = String(r.gerecht).toLowerCase();\n  return g.includes(gezocht) || gezocht.includes(g);\n});\n// Is er een datum gevraagd, dan alleen die dag. Anders niet de hele geschiedenis wissen,\n// maar alleen de laatste keer dat dit gerecht gelogd is — dat is wat je bedoelt als je\n// zegt 'haal de pasta weg'.\nif (invoer.datumOpgegeven) {\n  matches = matches.filter(r => String(r.gegeten_op) === invoer.datum);\n} else if (matches.length > 1) {\n  matches.sort((a, b) => String(b.gegeten_op).localeCompare(String(a.gegeten_op)));\n  matches = [matches[0]];\n}\nif (!matches.length) {\n  const erbij = invoer.datumOpgegeven ? ` op ${invoer.datum}` : '';\n  return [{ json: { id: '', geenMatch: true, melding: `Geen maaltijd gevonden die lijkt op '${invoer.gerecht}'${erbij}.` } }];\n}\nreturn matches.map(r => ({ json: { id: r.id, gerecht: r.gerecht, gegeten_op: r.gegeten_op } }));\n"
      }
    },
