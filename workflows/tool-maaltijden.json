      "name": "Bevestig loggen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        -240
      ],
      "parameters": {
        "jsCode": "// Controleer eerst of de schrijfactie hierboven wel gelukt is: die node gaat bij een\n// fout gewoon door, dus zonder deze check zou hier succes gemeld worden terwijl er niets\n// is opgeslagen.\nconst schrijfUitvoer = $input.all().map(i => i.json);\nif (schrijfUitvoer.length > 0 && schrijfUitvoer[0] && schrijfUitvoer[0].error != null) {\n  return [{ json: { resultaat: 'Het opslaan van de maaltijd is niet gelukt. Controleer in n8n of de tabel \\'maaltijden\\' is geselecteerd in de node \\'Maaltijd opslaan\\'.' } }];\n}\nconst invoer = $('Normaliseren').first().json;\nif (!invoer.gerecht) {\n  return [{ json: { resultaat: 'Er is geen gerecht opgegeven om te loggen.' } }];\n}\nreturn [{ json: { resultaat: `Genoteerd: op ${invoer.datum} eten jullie ${invoer.gerecht}.` } }];"
      }
    },
